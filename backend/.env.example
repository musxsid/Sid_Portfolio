# ==========================================
# Sid Portfolio Backend Environment Config
# ==========================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portfolio_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Server Port (Render / Koyeb default)
PORT=8080

# Production Frontend Allowed Origins (CORS)
CLIENT_URL=https://your-portfolio.vercel.app
# FRONTEND_URL is also supported as an alias
# FRONTEND_URL=https://your-portfolio.vercel.app

# GitHub Live Sync (Optional - increases rate limits)
GITHUB_USERNAME=musxsid
GITHUB_TOKEN=your_github_personal_access_token

# Groq Cloud AI Assistant (Optional - falls back to deterministic local knowledge engine if empty)
GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Keycloak OAuth2 / JWT (Optional for public frontend, required for Admin CMS CRUD)
KEYCLOAK_ISSUER_URI=
