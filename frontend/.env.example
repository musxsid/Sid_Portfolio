# ============================================
# Sid Portfolio Frontend Environment Config
# ============================================

# Backend API Base URL (Render / Koyeb / Local)
# Fallback defaults to http://localhost:8080 if not set
VITE_API_BASE_URL=http://localhost:8080

# Production Example on Vercel:
# VITE_API_BASE_URL=https://your-backend-app.onrender.com

# Legacy / Alias variable (also supported):
# VITE_API_URL=https://your-backend-app.onrender.com

# Optional client-side Groq fallback key
# VITE_GROQ_API_KEY=gsk_...
